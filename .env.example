OPENAI_API_KEY=
EXA_API_KEY=
# Set LLM_PROVIDER=cerebras after configuring and validating the key.
LLM_PROVIDER=openai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3.8-27b
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Disabled by default. Enable only with explicit authorization to send real messages.
ENABLE_EXTERNAL_NOTIFICATIONS=false
# WhatsApp remains separately opt-in, and also requires the global flag above.
ENABLE_WHATSAPP_NOTIFICATIONS=false
SCHEDULER_ENABLED=true
NOTIFICATION_TIMEZONE=Asia/Kolkata
COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
# Set false to disable user-initiated Live sessions.
LIVE_ENABLED=true
